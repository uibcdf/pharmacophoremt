        "utf8": "\"\"\"Serial offline reporting checks for the dated documentary recovery.\"\"\"\n\nimport json\nimport os\nimport resource\nimport subprocess\nimport sys\nfrom pathlib import Path\n\ncase = Path(__file__).resolve().parent\nroot = case.parents[1]\nos.chdir(root)\nresource.setrlimit(resource.RLIMIT_AS, (512 * 1024 * 1024,) * 2)\nfor name in (\"OMP_NUM_THREADS\", \"OPENBLAS_NUM_THREADS\", \"MKL_NUM_THREADS\", \"NUMEXPR_NUM_THREADS\", \"RAYON_NUM_THREADS\"):\n    os.environ[name] = \"1\"\nruff = \"/fast_data/home/liliana/miniconda3/envs/molsyssuite@uibcdf_3.14/bin/ruff\"\ncommands = [\n    [sys.executable, \"-B\", \"devtools/devguide_index.py\"],\n    [sys.executable, \"-B\", \"devtools/devguide_index.py\", \"--check\"],\n    [sys.executable, \"-B\", \"-m\", \"unittest\", \"discover\", \"-s\", \"tests\", \"-p\", \"test_reporting_protocol.py\"],\n    [sys.executable, \"-B\", \"-m\", \"unittest\", \"discover\", \"-s\", \"tests\", \"-p\", \"test_evidence_archive.py\"],\n    [sys.executable, \"-B\", \"-m\", \"devtools.evidence_archive\", \"devguide/evidence/brd4_unresolved_domain_20261106_summary.json\"],\n    [ruff, \"check\", \"--no-cache\", \".\"],\n    [ruff, \"format\", \"--check\", \"--no-cache\", \".\"],\n    [\"git\", \"diff\", \"--check\"],\n]\nresults = []\nfor command in commands:\n    result = subprocess.run(command, capture_output=True, text=True, timeout=120, check=False)\n    record = {\"command\": command, \"exit_code\": result.returncode, \"stdout\": result.stdout, \"stderr\": result.stderr}\n    results.append(record)\n    print(json.dumps(record), flush=True)\n    if result.returncode:\n        break\nwith (case / \"validation_results.json\").open(\"x\") as stream:\n    json.dump({\"commands\": results, \"resources\": {\"affinity\": sorted(os.sched_getaffinity(0)), \"nice\": os.getpriority(os.PRIO_PROCESS, 0), \"address_space_limit_bytes\": resource.getrlimit(resource.RLIMIT_AS)[0], \"backend_threads\": 1, \"serial\": True, \"no_swap_cgroup_claim\": False}}, stream, indent=2)\n    stream.write(\"\\n\")\nraise SystemExit(any(result[\"exit_code\"] for result in results))\n"
      },
      "verify_closeout_integrity.py": {
        "sha256": "4787e93ddbfed6c97d44cc6f55b441163a45194b8b92c549a49ea6cd3be1a518",
        "bytes": 2651,
        "utf8": "\"\"\"Verify frozen own artifacts and local targets of changed Markdown links.\"\"\"\n\nimport gzip\nimport hashlib\nimport json\nimport re\nimport subprocess\nfrom pathlib import Path\nfrom urllib.parse import unquote, urlsplit\n\ncase = Path(__file__).resolve().parent\nroot = case.parents[1]\nsummary_path = root / \"devguide/evidence/brd4_unresolved_domain_20261106_summary.json\"\nsummary = json.loads(summary_path.read_text())\nidentity = summary[\"full_evidence\"]\npacked = (summary_path.parent / identity[\"path\"]).read_bytes()\nraw = gzip.decompress(packed)\nfor prefix, data in ((\"compressed\", packed), (\"uncompressed\", raw)):\n    assert hashlib.sha256(data).hexdigest() == identity[prefix + \"_sha256\"]\n    assert len(data) == identity[prefix + \"_bytes\"]\nreport = json.loads(raw)\nfor name, file_identity in report[\"files\"].items():\n    assert \".private.\" not in Path(name).name\n    blob = report[\"utf8_blobs_by_sha256\"][file_identity[\"sha256\"]].encode()\n    assert hashlib.sha256(blob).hexdigest() == file_identity[\"sha256\"]\n    assert len(blob) == file_identity[\"bytes\"]\n    assert (root / name).read_bytes() == blob\nfor name, digest in summary[\"source_plan_files\"].items():\n    assert hashlib.sha256((root / name).read_bytes()).hexdigest() == digest\n\nchanged = subprocess.check_output([\"git\", \"diff\", \"--name-only\", \"--\", \"*.md\"], cwd=root, text=True).splitlines()\nnew = subprocess.check_output([\"git\", \"ls-files\", \"--others\", \"--exclude-standard\", \"--\", \"*.md\"], cwd=root, text=True).splitlines()\npages = sorted(set(changed + new))\nchecked = 0\nerrors = []\nfor name in pages:\n    path = root / name\n    for match in re.finditer(r\"\\[[^\\]]*\\]\\((<[^>]+>|[^\\s)]+)(?:\\s+[^)]*)?\\)\", path.read_text()):\n        link = match.group(1).strip(\"<>\")\n        if urlsplit(link).scheme or link.startswith((\"#\", \"//\")):\n            continue\n        target = unquote(link.split(\"#\", 1)[0].split(\"?\", 1)[0])\n        if not target:\n            continue\n        checked += 1\n        resolved = (path.parent / target).resolve()\n        if not resolved.exists():\n            errors.append({\"page\": name, \"target\": target})\nresult = {\"own_archived_files_verified\": len(report[\"files\"]), \"source_plan_hashes_verified\": len(summary[\"source_plan_files\"]), \"changed_markdown_pages_checked\": len(pages), \"local_links_checked\": checked, \"link_errors\": errors, \"private_original_bodies_excluded\": True, \"archive_identity_verified\": True, \"link_scope\": \"Local target existence only; anchors and external links not revalidated\"}\nwith (case / \"integrity_and_links.json\").open(\"x\") as stream:\n    json.dump(result, stream, indent=2)\n    stream.write(\"\\n\")\nprint(json.dumps(result))\nassert not errors\n"
      },
