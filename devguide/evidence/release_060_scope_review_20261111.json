    "text": "\"\"\"Read-only static comparison; no candidate or publication is selected.\"\"\"\nimport ast\nimport hashlib\nimport json\nimport subprocess\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parents[3]\nBASE = '2bff5dcf454bc5230f473237a49939215a60aab2'\nHEAD = (Path(__file__).resolve().parents[1] / 'frozen_source.txt').read_text().strip()\n\n\ndef git(*args):\n    return subprocess.check_output(['git', *args], cwd=ROOT, text=True)\n\n\ndef declarations(text):\n    rows = {}\n    def visit(body, prefix=''):\n        for node in body:\n            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):\n                if not node.name.startswith('_'):\n                    rows[prefix + node.name] = ast.unparse(node.args)\n            elif isinstance(node, ast.ClassDef):\n                visit(node.body, prefix + node.name + '.')\n    visit(ast.parse(text).body)\n    return rows\n\n\nchanges = [r.split('\\t') for r in git('diff', '--name-status', BASE, HEAD).splitlines()]\nruntime = [r for r in changes if r[-1].endswith('.py') and r[-1].split('/')[0] in ['pharmacophoremt', 'pharmacophoremt_features', 'pharmacophoremt_results']]\nremoved = []\nsignatures = []\nadded = []\nfor status, path in runtime:\n    old = {} if status == 'A' else declarations(git('show', BASE + ':' + path))\n    new = {} if status == 'D' else declarations(git('show', HEAD + ':' + path))\n    removed.extend(path + ':' + k for k in old.keys() - new.keys())\n    added.extend(path + ':' + k for k in new.keys() - old.keys())\n    signatures.extend({'path': path, 'declaration': k, 'before': old[k], 'after': new[k]} for k in old.keys() & new.keys() if old[k] != new[k])\nunchanged = {}\nfor path in ['pharmacophoremt/modeler/features.py', 'pharmacophoremt/screening/pose_evaluation.py', 'pharmacophoremt/validation/metrics.py', 'pharmacophoremt/screening/rigid_search.py']:\n    # Record exact paths that exist rather than assume implementation ownership.\n    if not (ROOT / path).is_file():\n        continue\n    before = git('show', BASE + ':' + path).encode()\n    after = git('show', HEAD + ':' + path).encode()\n    assert before == after\n    unchanged[path] = hashlib.sha256(after).hexdigest()\nrecord = {'schema': 'pharmacophoremt.release-060.scope-review@1', 'base_tag': '0.5.0', 'base': BASE, 'reviewed_source': HEAD, 'commit_count': int(git('rev-list', '--count', BASE + '..' + HEAD)), 'changes': changes, 'runtime_changes': runtime, 'removed_nonprivate_declarations': sorted(removed), 'changed_existing_declared_signatures': signatures, 'new_nonprivate_declarations': sorted(added), 'unchanged_scientific_owners': unchanged, 'static_count_limit': 'Declarations in implementation modules are not independently public APIs; static signature comparison does not establish semantic compatibility or scientific/delivery qualification.', 'candidate_selected': False, 'version_plan_changed': False, 'tag_or_publication_selected': False, 'next': 'Review migration/resource/dependency effects under #95, then explicitly freeze one candidate and choose an exact-source hosted checkpoint under #9; no tag before those separate gates.'}\npath = ROOT / 'devguide/evidence/release_060_scope_review_20261111.json'\nrecord['review_script']={'sha256':hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),'text':Path(__file__).read_text()}\npath.write_text(json.dumps(record, indent=2) + '\\n')\nprint(json.dumps({k: record[k] for k in ['base', 'reviewed_source', 'commit_count', 'removed_nonprivate_declarations', 'changed_existing_declared_signatures', 'unchanged_scientific_owners']}))\n"
