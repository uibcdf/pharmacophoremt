      "content": "\"\"\"Receive original bodies and exact public recipe from the single owned wheel.\"\"\"\nimport hashlib\nimport importlib.metadata\nimport json\nimport os\nfrom pathlib import Path\nimport re\nimport resource\nimport subprocess\nimport sys\nimport sysconfig\nimport xml.etree.ElementTree as ET\n\nCASE=Path(__file__).resolve().parents[1]\nROOT=CASE.parents[1]\nPLAN=json.loads((CASE/'installed_context_plan.json').read_text())\nBUILD=json.loads((CASE/'owned_build.json').read_text())\nresource.setrlimit(resource.RLIMIT_DATA,(536870912,536870912))\nassert sys.flags.isolated and sys.flags.no_site and sys.dont_write_bytecode\nassert os.sched_getaffinity(0)=={19} and os.getpriority(os.PRIO_PROCESS,0)==19\nmemory=Path('/proc/meminfo').read_text();pressure=Path('/proc/pressure/memory').read_text()\nassert int(next(x.split()[1] for x in memory.splitlines() if x.startswith('MemAvailable:')))>2*1024*1024\nassert all(float(x.split('avg10=')[1].split()[0])<1 for x in pressure.splitlines())\nassert Path.cwd()==Path(PLAN['cwd']) and not Path.cwd().is_relative_to(ROOT)\nconfig={'target':PLAN['target'],'fixtures':PLAN['fixtures'],\n    'forbidden_roots':[str(ROOT),str(CASE/'source')],\n    'admitted_roots':[PLAN['target'],PLAN['fixtures'],*PLAN['explicit_provider_roots'],PLAN['site_packages']],\n    'provider_mapping':{name:value for row in PLAN['editable_mapping_declarations'] for name,value in row['mapping'].items()},\n    'search_roots':[PLAN['target'],PLAN['fixtures'],PLAN['site_packages']],\n    'stdlib_roots':[sysconfig.get_path('stdlib'),str(Path(sysconfig.get_path('stdlib')).parent/'python314.zip')],\n    'control_files':[str(p) for p in (CASE/'controls').glob('*.py')],\n    'base_sys_path':list(sys.path),'shared_sdk':PLAN['shared_sdk']}\nboundary_source=(CASE/'controls/boundary.py').read_text()\nexec(compile(boundary_source,str(CASE/'controls/boundary.py'),'exec'))\nguard=_ReceivingBoundary(config)\nsys.meta_path.insert(0,guard)\n\n\ndef identity(path):\n    digest=hashlib.sha256()\n    with Path(path).open('rb') as stream:\n        for block in iter(lambda:stream.read(1024*1024),b''):digest.update(block)\n    return dict(bytes=Path(path).stat().st_size,sha256=digest.hexdigest())\n\n\ndef provider_files():\n    result={}\n    for row in PLAN['editable_mapping_declarations']:\n        for name,value in row['mapping'].items():\n            p=Path(value)\n            result[name]={str(x.relative_to(p)) if p.is_dir() else x.name:identity(x)\n                for x in (sorted(p.rglob('*.py')) if p.is_dir() else [p])}\n    return result\n\n\nproviders_before=provider_files()\nfor name,wanted in PLAN['fixture_files'].items():assert identity(Path(PLAN['fixtures'])/name)==wanted\nfor name,wanted in BUILD['runtime_files_equal'].items():assert identity(Path(PLAN['target'])/name)==wanted\nassert identity(Path(BUILD['wheel']['path']))=={key:BUILD['wheel'][key] for key in ('bytes','sha256')}\nimport pharmacophoremt as phmt\nimport pharmacophoremt_results\nassert Path(phmt.__file__).resolve()==Path(PLAN['target'])/'pharmacophoremt/__init__.py'\nassert phmt.__version__==BUILD['version']==importlib.metadata.version('pharmacophoremt')\nimport pytest\nsys.path.insert(0,str(Path(PLAN['fixtures'])/'tests'))\nimport test_public_run_results as fixture\nchildren=[]\n\n\ndef fresh(self,source,*arguments):\n    number=len(children)\n    report=CASE/f'installed-child-{number}.json'\n    bootstrap=boundary_source+'\\n'+'''\nimport json,sys\nfrom pathlib import Path\n_config=json.loads(sys.argv.pop(1))\n_report=Path(sys.argv.pop(1))\n_source=sys.argv.pop(1)\n_guard=_ReceivingBoundary(_config)\nsys.meta_path.insert(0,_guard)\ntry:\n    exec(compile(_source,'<original isolated reader child>','exec'))\nfinally:\n    _report.write_text(json.dumps(_guard.snapshot(),indent=2)+'\\\\n')\n'''\n    child=subprocess.run([sys.executable,'-I','-S','-B','-c',bootstrap,json.dumps(config),str(report),\n        fixture.FRESH_GUARD+source,str(fixture.ROOT),*map(str,arguments)],cwd=PLAN['cwd'],capture_output=True,text=True,timeout=30,check=False)\n    assert report.is_file(),child.stderr\n    streams={}\n    for name,text in [('stdout',child.stdout),('stderr',child.stderr)]:\n        path=CASE/f'installed-child-{number}.{name}';path.write_text(text);streams[name]=identity(path)\n    children.append(dict(index=number,exit_code=child.returncode,guard=report.name,guard_identity=identity(report),streams=streams))\n    (CASE/'installed_children.json').write_text(json.dumps(children,indent=2)+'\\n')\n    return child\n\n\n\nimport ackredit as ack\nimport test_saved_run_analysis as analytical\ngenerator=analytical.saved.__wrapped__()\nf=next(generator)\ntry:\n    before=f.directory_bytes()\n    from pharmacophoremt_results import ScreeningRunView\n    with ScreeningRunView.open(f.path) as view:\n        with ack.session(\"enclosing application\") as application:\n            with ack.capture(\"saved-run analytical summary\") as capture, phmt.attribution():\n                result=analytical.summarize(view,f)\n            assert ack.current_session() is application\n    assert f.directory_bytes()==before\n    references=capture.attribution.to_dict()\n    encoded=json.dumps(references)\n    assert result[\"attribution\"][\"status\"]==\"captured\"\n    assert \"validation.screening_runs.summarize_screening_run\" in encoded\n    assert \"validation.metrics.bedroc\" in encoded\n    assert \"never credit this saved source\" not in encoded\n    assert result[\"records\"][1][\"outcome\"][\"native_result\"][\"attribution\"]==f.native[\"alpha\"][\"attribution\"]\n    assert providers_before==provider_files()\n    snapshot=guard.snapshot()\n    payload=dict(schema=\"pharmacophoremt.saved-run-analysis-attribution@1\",source_commit=BUILD[\"source_commit\"],wheel=BUILD[\"wheel\"],version=BUILD[\"version\"],\n        result=result,references=references,application_session_preserved=True,original_bytes_and_source_attribution_preserved=True,\n        provider_files_unchanged=True,forbidden_import_attempts=snapshot[\"forbidden_import_attempts\"],\n        scope=\"Real optional Ackredit over one synthetic six-sample partial-run summary from the exact installed artifact; no real activity/molecular/source re-attribution or new independent test count\")\n    (CASE/\"installed_attribution.json\").write_text(json.dumps(payload,indent=2)+\"\\n\")\n    print(json.dumps(dict(reference_keys=list(references),items=len(references.get(\"items\",[])),uses=len(references.get(\"uses\",[])),captured=True)),flush=True)\nfinally:\n    generator.close()\n"
