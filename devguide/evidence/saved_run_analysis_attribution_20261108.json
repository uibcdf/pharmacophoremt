      "content": "\"\"\"Bounded launcher; preserve every attempt without rebuilding the wheel.\"\"\"\nimport hashlib\nimport json\nimport os\nimport resource\nimport subprocess\nimport sys\nimport time\nfrom pathlib import Path\n\nCASE=Path(__file__).resolve().parents[1]\nbuild=json.loads((CASE/'owned_build.json').read_text())\nresource.setrlimit(resource.RLIMIT_DATA,(536870912,536870912))\nassert os.sched_getaffinity(0)=={19} and os.getpriority(os.PRIO_PROCESS,0)==19\nnumber=len(list(CASE.glob('attribution-attempt*-command.json')))+1\nargs=[sys.executable,'-I','-S','-B',str(CASE/'controls/receive_attribution.py')]\nlog=CASE/f'attribution-attempt{number}.log'\nenv={key:value for key,value in os.environ.items() if key not in {'PYTHONPATH','PYTHONSTARTUP','COVERAGE_PROCESS_START','COVERAGE_PROCESS_CONFIG'} and not key.startswith('COV_CORE_')}\nenv['PYTEST_DISABLE_PLUGIN_AUTOLOAD']='1'\nenv['PYTEST_ADDOPTS']=''\nenv['PHMT_RECEIVING_ATTEMPT']=str(number)\nstart=time.monotonic()\nwith log.open('xb') as output:\n    run=subprocess.run(['/usr/bin/time','-v','-o',str(CASE/f'attribution-attempt{number}-resources.txt'),*args],cwd=build['cwd'],env=env,stdout=output,stderr=subprocess.STDOUT,timeout=180,check=False)\nraw=log.read_bytes()\nrecord={'arguments':args,'cwd':build['cwd'],'exit_code':run.returncode,\n    'seconds':time.monotonic()-start,'log':log.name,\n    'log_identity':{'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest()},\n    'wheel':build['wheel'],'version':build['version'],'source':build['source_commit']}\n(CASE/f'attribution-attempt{number}-command.json').write_text(json.dumps(record,indent=2)+'\\n')\nprint(json.dumps(record),flush=True)\nprint(log.read_text()[-5000:],flush=True)\nraise SystemExit(run.returncode)\n"
